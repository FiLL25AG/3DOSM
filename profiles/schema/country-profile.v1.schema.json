  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "group",
        "render",
        "color",
        "tier"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "render": {
          "enum": [
            "line",
            "area",
            "extrude",
            "point",
            "structure",
            "support"
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "casing": {
          "$ref": "#/$defs/color"
        },
        "widthMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minPixels": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "order": {
          "type": "integer"
        },
        "colorByTag": {"type": "string", "description": "Kolor obszaru z wartości tagu (np. surface) według mapy kolorów w profilu."},
        "note": {
          "type": "string"
        },
        "maxGrade": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Największy spadek przebiegu w modelu prezentacyjnym (m/m)."
        },
        "levelCheck": {
          "enum": [
            "transport",
            "water",
            "none"
          ]
        },
        "contextObstacle": {
          "type": "boolean"
        },
        "carriageway": {
          "type": "boolean"
        },
        "stairs": {
          "type": "boolean"
        },
        "impact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "surfaced": {
          "type": "boolean"
        },
        "routeLine": {
          "type": "string"
        },
        "lineColor": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "op"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "exists",
            "absent",
            "eq",
            "ne",
            "in",
            "notIn"
          ]
        },
        "value": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "eq",
                  "ne"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "in",
                  "notIn"
                ]
              }
            }
          },
          "then": {
            "required": [
              "values"
            ]
          }
        }
      ]
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "none": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "geometry": {
          "type": "array",
          "items": {
            "enum": [
              "point",
              "line",
              "area"
            ]
          },
          "minItems": 1
        },
        "classPrefix": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "memberOfRoute": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "order",
        "when",
        "source",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "phase": {
          "enum": [
            "classify",
            "attribute"
          ]
        },
        "order": {
          "type": "integer"
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "setClass": {
          "type": "string"
        },
        "setAttributes": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "number"
            ]
          }
        },
        "readNumber": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attribute",
            "key",
            "min",
            "max"
          ],
          "properties": {
            "attribute": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "integer": {
              "type": "boolean"
            }
          }
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "rationale": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "classify"
              }
            }
          },
          "then": {
            "required": [
              "setClass"
            ]
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "severity",
        "confidence",
        "when",
        "message",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "category": {
          "enum": [
            "missing",
            "uncertain"
          ]
        },
        "severity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "confidence": {
          "enum": [
            "niska",
            "średnia",
            "wysoka"
          ]
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "message": {
          "type": "string"
        },
        "suggest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "reason",
              "doc"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "doc": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "source": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
