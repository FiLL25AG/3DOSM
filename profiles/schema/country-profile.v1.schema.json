{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3dosm.local/schema/country-profile.v1.schema.json",
  "title": "Profil kraju 3D OSM, wersja schematu 1",
  "description": "Konfiguracja deklaratywna. Schemat dopuszcza wyłącznie dane: nie ma pól na kod ani wyrażenia.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileVersion",
    "country",
    "name",
    "maintenance",
    "labels",
    "vertical",
    "dimensions",
    "inferredSupports",
    "surfaces",
    "barriers",
    "tunnels", "roofs", "vegetation", "furniture", "sports",
    "steps",
    "groups",
    "classes",
    "rules",
    "checks",
    "knownValues"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "profileVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed",
        "process",
        "scope"
      ],
      "properties": {
        "reviewed": {
          "type": "string",
          "format": "date"
        },
        "process": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nameKeys"
      ],
      "properties": {
        "nameKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "vertical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layerStepMeters",
        "rampMeters",
        "assumedBridgeLayer",
        "note"
      ],
      "properties": {
        "layerStepMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rampMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "assumedBridgeLayer": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metersPerLevel",
        "defaultBuildingHeightMeters"
      ],
      "properties": {
        "metersPerLevel": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "defaultBuildingHeightMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "inferredSupports": {
      "description": "Parametry podpór wnioskowanych z geometrii. Takie obiekty nie są danymi OSM.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spacingMeters",
        "minClearanceMeters",
        "columnWidthMeters",
        "deckThicknessMeters",
        "obstacleMarginMeters",
        "mergeDistanceMeters"
      ],
      "properties": {
        "spacingMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minClearanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "columnWidthMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "deckThicknessMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "obstacleMarginMeters": {
          "type": "number",
          "minimum": 0
        },
        "mergeDistanceMeters": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "surfaces": {
      "description": "Materiały nawierzchni, linie przebiegu i oznakowanie poziome. Wartości zależne od kraju są wyłącznie tutaj.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultMaterial",
        "drivingSide",
        "markingColor",
        "assumedMarkingColor",
        "materials",
        "surfaceMaterials",
        "laneWidthMeters",
        "routeLineWidthRatio",
        "routeLineMinWidthMeters",
        "routeLineMinPixels",
        "markingWidthMeters",
        "edgeLineWidthMeters",
        "edgeLineInsetMeters",
        "markingMinPixels",
        "dashMeters",
        "gapMeters",
        "junctionClearMeters",
        "arrowDistanceMeters",
        "arrowMinWayMeters",
        "crossingWidthMeters",
        "crossingStripeMeters",
        "crossingPeriodMeters",
        "routeLineMaxWidthMeters",
        "cycleCrossingWidthMeters",
        "crossingBlockMeters",
        "crossingClearMeters",
        "arrowHalfLengthMeters",
        "routeLineCrossingRatio",
        "crossingMarkings",
        "crossingCompactPeriodMeters",
        "crossingCompactStripeMeters"
      ],
      "properties": {
        "defaultMaterial": {
          "type": "string"
        },
        "drivingSide": {
          "enum": [
            "right",
            "left"
          ]
        },
        "markingColor": {
          "$ref": "#/$defs/color"
        },
        "assumedMarkingColor": {
          "$ref": "#/$defs/color"
        },
        "materials": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "color",
              "accent",
              "pattern",
              "markable"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "markable": {
                "type": "boolean",
                "description": "Czy na nawierzchni rysowane jest oznakowanie poziome jezdni (linie pasów, krawędziowe, strzałki)."
              },
              "color": {
                "$ref": "#/$defs/color"
              },
              "accent": {
                "$ref": "#/$defs/color"
              },
              "pattern": {
                "enum": [
                  "speckle",
                  "pavers",
                  "planks",
                  "tread",
                  "blocks",
                  "hatch",
                  "solid"
                ]
              }
            }
          }
        },
        "surfaceMaterials": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "laneWidthMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "routeLineWidthRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "routeLineMinWidthMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "routeLineMinPixels": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "edgeLineWidthMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "edgeLineInsetMeters": {
          "type": "number",
          "minimum": 0
        },
        "markingWidthMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "markingMinPixels": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dashMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gapMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "junctionClearMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "arrowDistanceMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "arrowMinWayMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crossingWidthMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crossingStripeMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crossingPeriodMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "routeLineMaxWidthMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cycleCrossingWidthMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crossingBlockMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crossingClearMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "arrowHalfLengthMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "routeLineCrossingRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crossingMarkings": {
          "description": "Znaczenie wartości crossing:markings i crossing w danym kraju. Wartość spoza mapy nie tworzy malowania.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern",
              "applies",
              "label"
            ],
            "properties": {
              "pattern": {
                "enum": [
                  "zebra",
                  "blocks",
                  "edges"
                ]
              },
              "applies": {
                "enum": [
                  "foot",
                  "cycle",
                  "any"
                ]
              },
              "label": {
                "type": "string"
              },
              "approximate": {
                "type": "boolean"
              },
              "generic": {
                "type": "boolean",
                "description": "Wartość mówi tylko, że obiekt jest oznakowany; wzór zależy od rodzaju obiektu."
              },
              "cycle": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pattern",
                  "label"
                ],
                "properties": {
                  "pattern": {
                    "enum": [
                      "zebra",
                      "blocks",
                      "edges"
                    ]
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "crossingCompactPeriodMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crossingCompactStripeMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "barriers": {
      "description": "Bariery: wysokość i grubość z typu stosowane tylko przy braku tagów; nieznany typ przyjmuje fallback.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fallback",
        "materials",
        "types",
        "nodes"
      ],
      "properties": {
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "height": {
              "type": "number",
              "minimum": 0
            },
            "thickness": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "pattern": {
              "enum": [
                "solid",
                "masonry",
                "planks",
                "mesh",
                "railing",
                "hedge",
                "guard",
                "handrail",
                "boom",
                "panel"
              ]
            },
            "shape": {
              "enum": [
                "gate",
                "boom",
                "post",
                "block",
                "kerb",
                "opening"
              ]
            },
            "opens": {
              "type": "boolean"
            },
            "solidTop": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "generic": {
              "type": "boolean"
            }
          }
        },
        "materials": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "color",
              "accent"
            ],
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "accent": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        },
        "types": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "height": {
                "type": "number",
                "minimum": 0
              },
              "thickness": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "minimum": 0
              },
              "pattern": {
                "enum": [
                  "solid",
                  "masonry",
                  "planks",
                  "mesh",
                  "railing",
                  "hedge",
                  "guard",
                  "handrail",
                  "boom",
                  "panel"
                ]
              },
              "shape": {
                "enum": [
                  "gate",
                  "boom",
                  "post",
                  "block",
                  "kerb",
                  "opening"
                ]
              },
              "opens": {
                "type": "boolean"
              },
              "solidTop": {
                "type": "boolean"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "accent": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "generic": {
                "type": "boolean"
              },
              "variants": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "height": {
                        "type": "number",
                        "minimum": 0
                      },
                      "thickness": {
                        "type": "number",
                        "minimum": 0
                      },
                      "width": {
                        "type": "number",
                        "minimum": 0
                      },
                      "pattern": {
                        "enum": [
                          "solid",
                          "masonry",
                          "planks",
                          "mesh",
                          "railing",
                          "hedge",
                          "guard",
                          "handrail",
                          "boom",
                          "panel"
                        ]
                      },
                      "shape": {
                        "enum": [
                          "gate",
                          "boom",
                          "post",
                          "block",
                          "kerb",
                          "opening"
                        ]
                      },
                      "opens": {
                        "type": "boolean"
                      },
                      "solidTop": {
                        "type": "boolean"
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "accent": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "generic": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "height": {
                "type": "number",
                "minimum": 0
              },
              "thickness": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "minimum": 0
              },
              "pattern": {
                "enum": [
                  "solid",
                  "masonry",
                  "planks",
                  "mesh",
                  "railing",
                  "hedge",
                  "guard",
                  "handrail",
                  "boom",
                  "panel"
                ]
              },
              "shape": {
                "enum": [
                  "gate",
                  "boom",
                  "post",
                  "block",
                  "kerb",
                  "opening"
                ]
              },
              "opens": {
                "type": "boolean"
              },
              "solidTop": {
                "type": "boolean"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "accent": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "generic": {
                "type": "boolean"
              },
              "variants": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "height": {
                        "type": "number",
                        "minimum": 0
                      },
                      "thickness": {
                        "type": "number",
                        "minimum": 0
                      },
                      "width": {
                        "type": "number",
                        "minimum": 0
                      },
                      "pattern": {
                        "enum": [
                          "solid",
                          "masonry",
                          "planks",
                          "mesh",
                          "railing",
                          "hedge",
                          "guard",
                          "handrail",
                          "boom",
                          "panel"
                        ]
                      },
                      "shape": {
                        "enum": [
                          "gate",
                          "boom",
                          "post",
                          "block",
                          "kerb",
                          "opening"
                        ]
                      },
                      "opens": {
                        "type": "boolean"
                      },
                      "solidTop": {
                        "type": "boolean"
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "accent": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "generic": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "steps": {
      "description": "Parametry i wygląd schodów. Wartości domyślne są jawnymi założeniami i są oznaczane jako przybliżone.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultRiserMeters",
        "minRiserMeters",
        "maxRiserMeters",
        "defaultTreadMeters",
        "minTreadMeters",
        "flatRiseMeters",
        "landingEverySteps",
        "landingLengthMeters"
      ],
      "properties": {
        "defaultRiserMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minRiserMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxRiserMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "defaultTreadMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minTreadMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "flatRiseMeters": {
          "type": "number",
          "minimum": 0
        },
        "landingEverySteps": {
          "type": "integer",
          "minimum": 2
        },
        "landingLengthMeters": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "groups": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "defaultVisible"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "defaultVisible": {
            "type": "boolean"
          },
          "parent": {
            "type": "string"
          }
        }
      }
    },
    "classes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]+(\\.[a-z_]+)?$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/class"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "knownValues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "furniture": {"description": "Bryły oświetlenia i linii energetycznych: wymiary domyślne i kolory (założenia prezentacyjne).", "type": "object", "additionalProperties": false, "required": ["streetLamps", "floodlights", "power", "doors", "gates"], "properties": {"note": {"type": "string"}, "streetLamps": {"type": "object", "additionalProperties": false, "required": ["heightMeters", "armMeters", "lowHeightMeters", "wallHeightMeters", "highMastMeters", "lowSupports", "wallSupports", "roadSearchMeters", "colour", "headColour"], "properties": {"source": {"type": "string"}, "heightMeters": {"type": "number", "exclusiveMinimum": 0}, "armMeters": {"type": "number", "minimum": 0}, "lowHeightMeters": {"type": "number", "exclusiveMinimum": 0}, "wallHeightMeters": {"type": "number", "exclusiveMinimum": 0}, "highMastMeters": {"type": "number", "exclusiveMinimum": 0}, "lowSupports": {"type": "array", "items": {"type": "string"}}, "wallSupports": {"type": "array", "items": {"type": "string"}}, "roadSearchMeters": {"type": "number", "exclusiveMinimum": 0}, "colour": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "headColour": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}}, "floodlights": {"type": "object", "additionalProperties": false, "required": ["heightMeters", "colour", "headColour"], "properties": {"source": {"type": "string"}, "heightMeters": {"type": "number", "exclusiveMinimum": 0}, "colour": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "headColour": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}}, "power": {"type": "object", "additionalProperties": false, "required": ["distributionMaxVoltage", "pole", "tower", "sagFraction", "defaultCables", "maxCables", "wireColour", "transformerColour"], "properties": {"source": {"type": "string"}, "distributionMaxVoltage": {"type": "number", "exclusiveMinimum": 0}, "pole": {"type": "object", "additionalProperties": false, "required": ["heightMeters", "spacingMeters", "colour"], "properties": {"heightMeters": 